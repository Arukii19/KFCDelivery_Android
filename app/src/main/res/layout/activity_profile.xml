<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9FB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E4002B"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Back"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <TextView
                android:id="@+id/tvProfileInitials"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#E4002B"
                android:gravity="center"
                android:background="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFD1D1"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#CC0000"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Tab Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnTabProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E4002B"
            android:text="👤 Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnTabOrders"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F0F0F0"
            android:text="📦 My Orders"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Profile Details Tab -->
    <LinearLayout
        android:id="@+id/layoutProfileDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etProfFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:hint="First Name"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#222222"/>

                <EditText
                    android:id="@+id/etProfLastName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Last Name"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#222222"/>

                <EditText
                    android:id="@+id/etProfPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#222222"/>

                <EditText
                    android:id="@+id/etProfEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Email Address (optional)"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#222222"/>

                <EditText
                    android:id="@+id/etProfAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Default Delivery Address"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:background="@drawable/bg_rounded_input"
                    android:padding="16dp"
                    android:textColor="#222222"/>

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#E4002B"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- My Orders Tab -->
    <LinearLayout
        android:id="@+id/layoutMyOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"/>
    </LinearLayout>

</LinearLayout>
