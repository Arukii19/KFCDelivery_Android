<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9FB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E4002B"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRiderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, Rider! 🛵"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnRiderLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#CC0000"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Tab Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnTabActive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E4002B"
            android:text="🛵 Active"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btnTabHistory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#F0F0F0"
            android:text="📋 History"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btnTabRiderProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#F0F0F0"
            android:text="👤 Profile"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Active Deliveries Tab -->
    <LinearLayout
        android:id="@+id/layoutRiderActive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvNoDeliveries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active deliveries assigned to you."
            android:textSize="15sp"
            android:textColor="#888888"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRiderActive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false"/>
    </LinearLayout>

    <!-- History Tab -->
    <LinearLayout
        android:id="@+id/layoutRiderHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRiderHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false"/>
    </LinearLayout>

    <!-- Profile Tab -->
    <LinearLayout
        android:id="@+id/layoutRiderProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRiderProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rider Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:id="@+id/tvRiderProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone: —"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvRiderProfileVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle: —"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
